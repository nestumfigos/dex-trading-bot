# ============================================================
#  DEX MOMENTUM BOT — ENVIRONMENT VARIABLES
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ============================================================

# --- PAPER TRADING (set to true to run without real money) ---
PAPER_TRADING=true
PAPER_BALANCE_USD=10000

# --- SOLANA / JUPITER ---
# Your Solana wallet private key (base58 encoded)
# Get from Phantom → Settings → Export Private Key
SOLANA_PRIVATE_KEY=5jCrphTDVbehrvp3oKJWKyk4gtAJ1TN62d68wETnNoX3WwUsEvtWTARzSYfw1agGWb81mDTxATUBKcDTBjGaySae

# Solana RPC endpoint
# Free tier: https://api.mainnet-beta.solana.com
# Recommended paid: Helius (https://helius.dev) or QuickNode (https://quicknode.com)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Helius API key (for token metadata + price feeds)
# Sign up free at https://helius.dev
HELIUS_API_KEY=your_helius_api_key_here

# --- BSC / PANCAKESWAP ---
# Your BSC wallet private key (0x prefixed hex)
# Get from MetaMask → Account Details → Export Private Key
BSC_PRIVATE_KEY=0x954ee01af96e508e835afe72ab16cf5be412d440c78df7d15bcc12fa3232fab1

# BSC RPC endpoint
# Free: https://bsc-dataseed.binance.org
# Recommended paid: NodeReal (https://nodereal.io) or QuickNode
BSC_RPC_URL=https://bsc-dataseed.binance.org

# --- BASE / BASESWAP ---
# Your Base wallet private key (same MetaMask key works if same address)
BASE_PRIVATE_KEY=0x954ee01af96e508e835afe72ab16cf5be412d440c78df7d15bcc12fa3232fab1

# Base RPC endpoint
# Free: https://mainnet.base.org
# Recommended paid: Alchemy (https://alchemy.com) — has generous free tier
BASE_RPC_URL=https://mainnet.base.org

# Alchemy API key (for Base — best free tier option)
# Sign up at https://alchemy.com → Create App → Network: Base
ALCHEMY_API_KEY=your_alchemy_api_key_here

# --- PRICE & MARKET DATA ---
# Birdeye API (Solana token data, prices, volume)
# Sign up at https://birdeye.so/api → free tier available
BIRDEYE_API_KEY=1c6ddeac318f4b46963e7787ca56c9ad
BIRDEYE_RPM_LIMIT=10
DEXSCREENER_CACHE_TTL_MS=300000

# CoinMarketCap free tier (optional; adds legitimacy and native price fallback)
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here
# Provider order for native asset prices: coingecko, dexscreener, coinmarketcap
NATIVE_PRICE_PROVIDER_ORDER=coingecko,dexscreener,coinmarketcap

# GoPlus API key (optional; improves honeypot API limits)
GOPLUS_API_KEY=your_goplus_api_key_here

# Groq API key (free tier available for Llama models)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini API key (Google AI Studio free tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# DexScreener (BSC + Base token data) — NO KEY NEEDED, free public API
# Used automatically for BSC and Base token screening

# --- TELEGRAM ALERTS ---
# Optional: Get alerts for trades, errors, and heartbeats
# Create bot: Message @BotFather on Telegram, create new bot, get token
TELEGRAM_TOKEN=your_telegram_bot_token_here
# Get chat ID: Message your bot, then visit https://api.telegram.org/bot<YourBOTToken>/getUpdates
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- RISK SETTINGS ---
MAX_POSITION_SIZE_PCT=3
KUCOIN_MAX_POSITION_SIZE_PCT=30
STOP_LOSS_PCT=8
TAKE_PROFIT_PCT=25
MIN_LIQUIDITY_USD=75000
MAX_PORTFOLIO_HEAT_PCT=45
BSC_MOMENTUM_HEAT_RESERVE_PCT=12
BSC_MIN_LIQUIDITY_USD=75000
BSC_YOUNG_TOKEN_MIN_LIQUIDITY_USD=150000
MAX_CONCURRENT_POSITIONS=5
DAILY_DRAWDOWN_LIMIT_PCT=15
MAX_DAILY_LOSS_PCT=10
NON_TRADE_LOG_RETENTION_HOURS=24
LOG_CLEANUP_INTERVAL_MINUTES=60

# Delay borderline stop-loss / trailing-stop exits to reduce stop-hunt noise
STOP_HUNT_DELAY_MS=30000
STOP_HUNT_BORDERLINE_PCT=0.35

# Adjust AI threshold by same-hour historical win rate
HOURLY_WIN_RATE_MODEL_ENABLED=true
HOURLY_WIN_RATE_MIN_TRADES=5
HOURLY_WIN_RATE_LOW_PCT=40
HOURLY_WIN_RATE_HIGH_PCT=60
HOURLY_WIN_RATE_THRESHOLD_ADJUST_PCT=5

# Fail closed on hung per-token market data fetches during scans
TOKEN_DATA_FETCH_TIMEOUT_MS=5000

# --- BOT SETTINGS ---
SCAN_INTERVAL_SECONDS=120
KUCOIN_SCAN_ALL_SYMBOLS=true
KUCOIN_MAX_TOKENS_PER_CYCLE=0
KUCOIN_BATCH_SIZE=4
KUCOIN_BATCH_DELAY_MS=550
HYBRID_POLL_TIMEOUT_MS=8000
PORT=3002
LOG_LEVEL=info

# --- DASHBOARD SECURITY ---
# Bind host defaults to localhost for safer local-only access.
DASHBOARD_BIND_HOST=127.0.0.1
# Optional: required token for write endpoints (POST /api/config, /api/backtest, etc.).
# Send as header: X-Admin-Token: <token> or Authorization: Bearer <token>
DASHBOARD_ADMIN_TOKEN=

# --- SQL SERVER (OPTION B: shared memory + coordination) ---
# Turn on SQL-backed shared AgentMemory + distributed locks
SQL_ENABLED=false
# Example (Windows local): Server=localhost\\SQLEXPRESS;Database=Agent;User Id=Agent;Password=YOUR_PASSWORD;TrustServerCertificate=True;Encrypt=True;
# Include Database/Initial Catalog explicitly so the bot does not rely on the login's default DB.
SQL_CONNECTION_STRING=
# TTL for distributed buy lock (ms). Prevents both bots entering same token simultaneously.
SQL_LOCK_TTL_MS=30000
SQL_TELEMETRY_FLUSH_MS=1500
SQL_TELEMETRY_BATCH_SIZE=50
SQL_POSITION_SNAPSHOT_MS=60000
SQL_STATE_SNAPSHOT_MS=120000
SQL_SELF_TEST_INTERVAL_MS=120000
SQL_QUERYABLE_SYNC_MS=120000
SQL_STATE_RESTORE_ENABLED=true
TRADINGVIEW_WEBHOOK_ENABLED=false
TRADINGVIEW_WEBHOOK_SECRET=
TRADINGVIEW_WEBHOOK_MAX_AGE_MS=21600000
RESEARCH_SCHEDULED_ENABLED=true
RESEARCH_NIGHTLY_HOUR_UTC=2
RESEARCH_NIGHTLY_MINUTE_UTC=15
RESEARCH_NIGHTLY_MAX_TARGETS=3
RESEARCH_JOBS_LIST_LIMIT=12
RESEARCH_TARGET_HISTORY_BARS=240
RESEARCH_MIN_HISTORY_BARS=120

# --- EXECUTION SAFETY ---
# Base slippage tolerance in bps (100 = 1%)
SLIPPAGE_BPS=100
EXECUTION_MAX_RETRIES=3
EXECUTION_RETRY_DELAY_MS=1200
BSC_MAX_GAS_COST_PCT_OF_TRADE=2
BSC_REQUIRE_TAX_DATA=true
BSC_MAX_BUY_TAX_PCT=5
BSC_MAX_SELL_TAX_PCT=5
BSC_MIN_FILL_PCT_OF_EXPECTED=95
SOLANA_PRIORITY_FEE_LAMPORTS=50000
SOLANA_ONLY_DIRECT_ROUTES=false
SOLANA_MAX_PRICE_IMPACT_PCT=5
KUCOIN_MAX_SLIPPAGE_PCT=1.2
NEWS_CACHE_TTL_MS=180000

# --- RESILIENCE / CIRCUIT BREAKERS ---
AI_FAILURE_THRESHOLD=5
AI_FAILURE_COOLDOWN_SECONDS=180
EXCHANGE_FAILURE_THRESHOLD=4
EXCHANGE_FAILURE_COOLDOWN_SECONDS=120

# --- ADVANCED RISK ---
MAX_TOKEN_AGE_HOURS=6

# --- ANTI-PATTERN EVASION (prevent bot identification & front-running) ---
# Enable/disable position size randomization (±15% by default)
ANTI_PATTERN_ENABLE_POSITION_JITTER=true
ANTI_PATTERN_POSITION_JITTER_PCT=15

# Enable/disable random entry delay (0-3s by default) before swap execution
ANTI_PATTERN_ENABLE_ENTRY_DELAY=true
ANTI_PATTERN_MAX_ENTRY_DELAY_MS=3000

# Enable/disable splitting large Solana trades into 2-3 smaller txs (>$2000 by default)
ANTI_PATTERN_ENABLE_SOLANA_SPLITS=true
ANTI_PATTERN_SOLANA_SPLIT_THRESHOLD_USD=2000
TRAILING_STOP_AFTER_MULTIPLIER=2
TRAILING_STOP_PCT=15
MAX_CORRELATION_PCT=75
AI_CONFIDENCE_FLOOR=70

# --- DYNAMIC MARKET REGIME ---
LOW_VOL_VOLUME_SPIKE_MULTIPLIER=2.1
HIGH_VOL_VOLUME_SPIKE_MULTIPLIER=3.0

# --- MOMENTUM FILTERS ---
BREAKOUT_LOOKBACK=20
BREAKOUT_BUFFER_PCT=0.002
MIN_NET_BUY_FLOW_USD=15000

# --- AI ENSEMBLE NARRATIVE GATE ---
AI_NARRATIVE_MIN_SCORE=65

# --- BSC DISCOVERY LANES ---
BSC_CORE_UNIVERSE_SIZE=140
BSC_CORE_MIN_LIQUIDITY_USD=150000
BSC_CORE_MIN_VOLUME_24H_USD=500000
BSC_EXPLORATION_ENABLED=true
BSC_EXPLORATION_UNIVERSE_SIZE=60
BSC_EXPLORATION_MIN_LIQUIDITY_USD=85000
BSC_EXPLORATION_MIN_VOLUME_24H_USD=150000
BSC_BORDERLINE_ENABLED=false
BSC_BORDERLINE_UNIVERSE_SIZE=10
BSC_BORDERLINE_MIN_LIQUIDITY_USD=65000
BSC_BORDERLINE_MIN_VOLUME_24H_USD=125000

# --- AI HOT PATH / CACHE ---
# Use cached AI decisions on the hot path and refresh in the background
AI_NON_BLOCKING=true
# Cache TTL for AI decisions in ms (default 5 minutes)
AI_DECISION_CACHE_MS=300000

# --- SWING ADX FILTER ---
# Require minimum trend strength for swing entries
STRATEGY_SWING_ADX_ENABLED=true
STRATEGY_SWING_ADX_PERIOD=14
STRATEGY_SWING_MIN_ADX=18

# --- LIQUIDITY SENTINEL ---
# Monitor LP burn/remove-liquidity style events for open EVM positions
LIQUIDITY_SENTINEL_ENABLED=true

# --- ANTHROPIC AI SIGNALING ---
ANTHROPIC_ENABLED=true
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_TEMPERATURE=0.2

# --- BACKTEST MONTE CARLO ---
BACKTEST_MONTE_CARLO_RUIN_THRESHOLD_PCT=15

# --- KUCOIN MOMENTUM TUNING ---
STRATEGY_MOMENTUM_KUCOIN_POSITION_SIZE_PCT=30

# --- BSC MOMENTUM LANES ---
STRATEGY_MOMENTUM_BSC_CORE_MIN_LIQUIDITY=150000
STRATEGY_MOMENTUM_BSC_CORE_MIN_24H_VOLUME=500000
STRATEGY_MOMENTUM_BSC_EXPLORATION_MIN_LIQUIDITY=85000
STRATEGY_MOMENTUM_BSC_EXPLORATION_MIN_24H_VOLUME=150000
STRATEGY_MOMENTUM_BSC_EXPLORATION_SIZE_MULTIPLIER=0.6
STRATEGY_MOMENTUM_BSC_BORDERLINE_ENABLED=false
STRATEGY_MOMENTUM_BSC_BORDERLINE_MIN_LIQUIDITY=65000
STRATEGY_MOMENTUM_BSC_BORDERLINE_MIN_24H_VOLUME=125000
STRATEGY_MOMENTUM_BSC_BORDERLINE_MIN_ABS_PRICE_CHANGE_24H=3
STRATEGY_MOMENTUM_BSC_BORDERLINE_MIN_BUY_RATIO_PCT_5M=60
STRATEGY_MOMENTUM_BSC_BORDERLINE_MIN_UNIQUE_BUYERS_5M=5
STRATEGY_MOMENTUM_BSC_BORDERLINE_SIZE_MULTIPLIER=0.35
STRATEGY_MOMENTUM_BSC_MIN_BUY_RATIO_PCT_5M=45
STRATEGY_MOMENTUM_BSC_MIN_UNIQUE_BUYERS_5M=3
STRATEGY_MOMENTUM_BSC_RELAXED_CONTINUATION_ENABLED=true
STRATEGY_MOMENTUM_BSC_RELAXED_MIN_LIQUIDITY=100000
STRATEGY_MOMENTUM_BSC_RELAXED_MIN_BUY_RATIO_PCT_5M=45
STRATEGY_MOMENTUM_BSC_RELAXED_VOLUME_SPIKE=1.2
STRATEGY_MOMENTUM_BSC_RELAXED_SIZE_MULTIPLIER=0.85
