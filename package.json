{
  "name": "dex-momentum-bot",
  "version": "1.0.0",
  "description": "Momentum trading bot for Jupiter (Solana), PancakeSwap (BSC), BaseSwap (Base)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "paper": "cross-env PAPER_TRADING=true PORT=3001 node src/index.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:restart": "pm2 restart dex-bot",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@solana/spl-token": "^0.3.11",
    "@solana/web3.js": "^1.87.6",
    "axios": "^1.15.0",
    "bs58": "^5.0.0",
    "ccxt": "^4.5.49",
    "cross-env": "^10.1.0",
    "dotenv": "^16.3.1",
    "ethers": "^6.9.0",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.67.0",
    "openai": "^6.34.0",
    "redis": "^5.12.1",
    "winston": "^3.11.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
