{
  "name": "dex-momentum-bot",
  "version": "1.1.0",
  "description": "Momentum trading bot for Jupiter (Solana), PancakeSwap (BSC), BaseSwap (Base)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "paper": "cross-env PAPER_TRADING=true PORT=3001 node src/index.js",
    "setup:paper:worktree": "node scripts/setup-paper-worktree.js",
    "sql:init": "node scripts/init-sql.js",
    "sql:backfill": "node scripts/backfill-sql-history.js",
    "research:hyperopt": "node scripts/hyperopt-strategy.js",
    "research:validate": "node scripts/validate-strategy.js",
    "models:register": "node scripts/register-models.js",
    "models:register:production": "node scripts/register-production-models.js",
    "models:train:production": "node scripts/train-production-models.js",
    "rl:train": "node scripts/train-rl-policy.js",
    "rl:train:production": "node scripts/train-production-rl.js",
    "python:sidecar:health": "node scripts/python-sidecar-health.js",
    "ops:v2-smoke": "node scripts/v2-platform-smoke.js",
    "ops:v2-roadmap": "node scripts/v2-roadmap-readiness.js --runtime",
    "test": "node scripts/run-tests.js",
    "test:v2-smoke": "node --test test/core-contracts.test.js test/dashboard-v2-report.test.js test/dashboard-trade-history.test.js test/docker-compose-v2.test.js test/v2-ci-workflow.test.js test/strategy-routing-audit.test.js test/sql-telemetry-regression.test.js test/stats/metrics-compute.test.js test/cycle/maintenance.test.js test/self-evolution-regressions.test.js test/risk/v2-risk-audit.test.js test/execution/min-net-dollar-edge.test.js test/v2-platform-smoke.test.js test/v2-roadmap-readiness.test.js",
    "test:integration": "node scripts/run-tests.js --integration",
    "test:all": "node scripts/run-tests.js --all",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:restart": "node scripts/pm2-safe-restart.js dex-bot live 3002",
    "pm2:paper:start": "node scripts/setup-paper-worktree.js && pm2 start ecosystem.config.js --only dex-bot-paper --env production",
    "pm2:paper:restart": "cd ..\\dex-trading-bot-paper && node scripts\\pm2-safe-restart.js dex-bot-paper paper 3003",
    "pm2:paper:stop": "pm2 stop dex-bot-paper",
    "pm2:paper:logs": "pm2 logs dex-bot-paper",
    "promote:paper": "node scripts/promote-paper-to-main.js",
    "rollback:live": "node scripts/rollback-live-promotion.js",
    "export:paper:lessons": "node scripts/export-paper-high-confidence-lessons.js",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:v2:config": "docker compose -f docker-compose.v2.yml config",
    "docker:v2:up": "docker compose -f docker-compose.v2.yml up -d --build",
    "docker:v2:down": "docker compose -f docker-compose.v2.yml down",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "check-updates": "npx npm-check-updates",
    "check-updates:apply": "npx npm-check-updates -u && npm install",
    "backtest": "node src/backtest.js",
    "simulate": "cross-env PAPER_TRADING=true node src/simulation.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@solana/spl-token": "^0.1.8",
    "@solana/web3.js": "^1.98.4",
    "axios": "^1.15.0",
    "bs58": "^5.0.0",
    "ccxt": "^4.5.49",
    "cross-env": "^10.1.0",
    "dotenv": "^16.3.1",
    "ethers": "^6.9.0",
    "express": "^4.18.2",
    "mssql": "^11.0.1",
    "node-cron": "^4.2.1",
    "node-telegram-bot-api": "^0.67.0",
    "openai": "^6.34.0",
    "proper-lockfile": "^4.1.2",
    "redis": "^5.12.1",
    "technicalindicators": "^3.1.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "playwright": "^1.60.0"
  }
}
